# Copy this file to .env before starting the simple profile.

# Required internal secrets. Generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_random_secret
BACKEND_AUTH_SECRET=replace_with_another_random_secret
POSTGRES_PASSWORD=replace_with_database_password
REDIS_PASSWORD=replace_with_redis_password

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Russian transcription and CPU rendering
TRANSCRIPT_LANGUAGE=ru
ROMANIZE_TRANSCRIPT=false
VIDEO_ENCODER=cpu
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=5
PROCESSING_TASK_TIMEOUT_SECONDS=7200

# Transcription: current stable path uses AssemblyAI.
ASSEMBLY_AI_API_KEY=replace_with_assemblyai_key

# Clip selection: choose one provider.
LLM=google-gla:gemini-2.0-flash
GOOGLE_API_KEY=replace_with_google_api_key
# LLM=openai:gpt-4.1-mini
# OPENAI_API_KEY=replace_with_openai_api_key
# LLM=anthropic:claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=replace_with_anthropic_api_key

# Optional YouTube ingestion. Direct file upload works without these.
YOUTUBE_METADATA_PROVIDER=yt_dlp
APIFY_API_TOKEN=
YOUTUBE_DATA_API_KEY=

# Disabled integrations
PEXELS_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
MAKE_INSTAGRAM_WEBHOOK_URL=
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=
