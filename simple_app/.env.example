# Оптимально для VPS 2 vCPU / 4 GB RAM
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
MAX_CLIPS=5
MIN_CLIP_SECONDS=25
MAX_CLIP_SECONDS=55
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23

# Необязательно: OpenAI-совместимая LLM выбирает моменты лучше эвристики.
# Для OpenAI: LLM_API_URL=https://api.openai.com/v1
# Для локального Ollama: LLM_API_URL=http://host.docker.internal:11434/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
